PORT=4000
COLLAB_PORT=4001
CLIENT_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Recommended locally: set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON file outside this repo.
# For managed hosting, prefer the platform's workload identity / application default credentials.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/cloudsync-service-account.json
# Optional alternative: minified service-account JSON. Keep this only in a private backend environment.
FIREBASE_SERVICE_ACCOUNT_JSON=
COLLAB_DATABASE=./data/collaboration.sqlite
